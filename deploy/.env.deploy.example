# 复制此文件为 .env.deploy 并填写你的服务器信息
# cp deploy/.env.deploy.example deploy/.env.deploy

# 服务器地址
DEPLOY_HOST=43.143.210.203

# SSH 用户名
DEPLOY_USER=root

# SSH 端口
DEPLOY_PORT=22

# 远程部署目录（宝塔网站根目录）
DEPLOY_PATH=/www/wwwroot/wenzhaohui.com         

# SSH 私钥路径（可选，留空则使用默认密钥）
# Windows 示例: C:/Users/你的用户名/.ssh/id_rsa
DEPLOY_KEY=C:/Users/zhaohui/.ssh/id_rsa

# 上传方式: auto | tar | scp | rsync
DEPLOY_METHOD=auto
